# Runtime data is persisted through docker-compose.yml:
#   ./data:/app/data
TOPIC_PULSE_DATA_DIR=/app/data

# LLM provider.
MINIMAX_API_KEY=

# Web search provider used by doubao_search.
DOUBAO_SEARCH_API_KEY=

# Email verification.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Topic Pulse
SMTP_USE_TLS=false
SMTP_USE_SSL=true
